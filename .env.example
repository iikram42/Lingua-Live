# Copy to .env for local development. Never commit real credentials.
PORT=3001
NODE_ENV=development
DATABASE_PATH=.data/rooms.sqlite
PRODUCT_NAME=Lingua Live
VITE_PRODUCT_NAME=Lingua Live
GOOGLE_CLOUD_PROJECT=
# In Vercel, set the full service-account JSON as a Secret environment variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Use Google Application Default Credentials. For a local service account file:
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=temporary-username
# TURN_CREDENTIAL=temporary-credential
# Production HTTPS origin. Required when deploying behind a reverse proxy.
APP_ORIGIN=
